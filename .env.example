# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ─── Yandex SMTP ───────────────────────────────────────────────────────────────
# Yandex account settings → Mail clients → enable SMTP access.
# If 2FA is on, generate an app password and use that here.
YANDEX_EMAIL=you@yandex.ru
YANDEX_PASSWORD=your_yandex_password_or_app_password

# ─── Apollo ────────────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key

# ─── KVK (optional) ────────────────────────────────────────────────────────────
KVK_API_KEY=

# ─── Vercel cron auth ──────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Set the same value in Vercel → Project Settings → Environment Variables.
CRON_SECRET=your_random_secret_here

# ─── Outreach settings ─────────────────────────────────────────────────────────
DAILY_SEND_LIMIT=40
SEND_TIMEZONE=Asia/Kolkata

# ─── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
