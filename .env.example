# ─── Supabase ──────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then copy URL + anon key
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ─── Gmail OAuth ───────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
# OAuth 2.0 Client ID (Web application type)
# Add http://localhost:3001/auth/callback to Authorized redirect URIs
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your_client_secret
GMAIL_REDIRECT_URI=http://localhost:3001/auth/callback

# ─── Apollo ────────────────────────────────────────────────────────────────────
# app.apollo.io → Settings → API Keys
APOLLO_API_KEY=your_apollo_api_key

# ─── KVK (optional) ────────────────────────────────────────────────────────────
# https://developers.kvk.nl — leave blank to skip Dutch company validation
KVK_API_KEY=

# ─── Outreach settings ─────────────────────────────────────────────────────────
# Max emails to send per day (per mailbox). Keep low if mailbox is new.
DAILY_SEND_LIMIT=50

# Timezone for business-hours check (no sends on weekends or before 7am)
SEND_TIMEZONE=Europe/Amsterdam

# ─── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
