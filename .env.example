# Server-only EpsiFlow engine configuration. Copy to .env.local.
# Never prefix these secrets with NEXT_PUBLIC_ or place them in dashboard/.env.local.

# Supabase backend access
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Yandex mailbox
YANDEX_EMAIL=
YANDEX_PASSWORD=
YANDEX_SMTP_HOST=smtp.yandex.com
YANDEX_IMAP_HOST=imap.yandex.com

# Vercel cron authentication (use at least 32 random characters)
CRON_SECRET=

# Instantly synchronization
INSTANTLY_API_KEY=
INSTANTLY_LIST_ID=
INSTANTLY_WORKSPACE_ID=
INSTANTLY_CAMPAIGN_ID=
INSTANTLY_WEBHOOK_SECRET=

# Stripe payment recovery
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2022-11-15
STRIPE_EVENT_INGESTION_ENABLED=false
STRIPE_EVENT_PROCESSING_ENABLED=false
STRIPE_PAYMENT_RECOVERY_ENABLED=false
STRIPE_ALLOW_LIVE_EVENTS=false
STRIPE_RECONCILIATION_ENABLED=false
STRIPE_RECONCILIATION_LOOKBACK_HOURS=48
STRIPE_RECONCILIATION_CASE_LIMIT=25
STRIPE_CLIENT_SUBSCRIPTION_RECONCILIATION_ENABLED=true
STRIPE_CLIENT_SUBSCRIPTION_WEBHOOK_ENABLED=true
STRIPE_CLIENT_SUBSCRIPTION_RECONCILIATION_MINUTES=360
STRIPE_CLIENT_SUBSCRIPTION_RECONCILIATION_LIMIT=5

# Transactional recovery email safety controls
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_DRY_RUN=true
TRANSACTIONAL_EMAIL_ALLOWLIST=
TRANSACTIONAL_EMAIL_MAX_ATTEMPTS=3
PAYMENT_RECOVERY_REMINDERS_ENABLED=false
PAYMENT_RECOVERY_FINAL_REMINDER_HOURS=8
PAYMENT_RECOVERY_SLACK_INITIAL_DELAY_MINUTES=20
PAYMENT_RECOVERY_REMINDER_CASE_LIMIT=25

# Slack recovery delivery and alerts
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_DELIVERY_ENABLED=false
SLACK_DELIVERY_DRY_RUN=true
SLACK_USER_ALLOWLIST=
SLACK_MAX_ATTEMPTS=3
SLACK_FAILURE_ALERTS_ENABLED=false
SLACK_FAILURE_ALERTS_DRY_RUN=true
SLACK_FAILURE_ALERT_CHANNEL_ID=
SLACK_FAILURE_ALERT_MAX_ATTEMPTS=3

# Outreach runtime
OUTREACH_ENABLED=false
DAILY_SEND_LIMIT=60
DAILY_NEW_LEAD_LIMIT=30
SENDS_PER_CYCLE=2
SEND_TIMEZONE=Asia/Tbilisi
SEND_START_HOUR=9
SEND_END_HOUR=18
REPLY_LOOKBACK_DAYS=30
CLIENT_CORRESPONDENCE_LOOKBACK_DAYS=90
CLIENT_INITIAL_CORRESPONDENCE_LOOKBACK_DAYS=730
LOCAL_CAMPAIGN_NAME=Epsi Test v1 - Local

# Optional acquisition sources
APOLLO_API_KEY=
KVK_API_KEY=

NODE_ENV=development
LOG_LEVEL=info
